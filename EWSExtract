# Get message by ID
function Get-EWSMessage {
    param(
        [Microsoft.Exchange.WebServices.Data.ExchangeService]$ExchService,
        [string]$MsgId
    )
    
    try {
        Write-Log "Retrieving message: $MsgId"
        
        $itemId = New-Object Microsoft.Exchange.WebServices.Data.ItemId($MsgId)
        #[Microsoft.Exchange.WebServices.Data.BasePropertySet]::FirstClassProperties,
        
        $propertySet = New-Object Microsoft.Exchange.WebServices.Data.PropertySet(
        [Microsoft.Exchange.WebServices.Data.BasePropertySet]::FirstClassProperties,
        [Microsoft.Exchange.WebServices.Data.ItemSchema]::DateTimeReceived)
        
        $propertySet.RequestedBodyType = [Microsoft.Exchange.WebServices.Data.BodyType]::HTML
        
        Write-Log "itemId: $itemId"
        
        #retry
        $Attempt = 1
        $conStat = $false
        
        do {
            try {
                $message = [Microsoft.Exchange.WebServices.Data.EmailMessage]::Bind($ExchService, $itemId, $propertySet)
                #$message = [Microsoft.Exchange.WebServices.Data.EmailMessage]::Bind($ExchService, $itemId)
                $conStat = $true
        
            }
            catch {
                
                write-Log $_.ToString()   -Level WARNING
                write-Log "Message not bound..."   -Level ERROR
                

                
                if ($_.ToString() -match 'Unauthorized'){
                    Start-Sleep -Seconds 30
                    $script:exchservice = (New-EWSService2 -Mailbox $MailboxName)[-1]
                }


            }
            $Attempt++
            
        } while ($Attempt -lt 5 -and $conStat -eq $false)

        if ($conStat){
            Write-Log "Message retrieved successfully: $($message.Subject)"
            return $message    
        } else {
            Write-Log "Failed to retrieve message $MsgId : $_" -Level "ERROR"
            throw

        }
        
        
    } catch {
        Write-Log "Failed to retrieve message $MsgId : $_" -Level "ERROR"
        throw
    }
}

# Get all messages in a conversation
function Get-ConversationMessages {
    param(
        [Microsoft.Exchange.WebServices.Data.ExchangeService]$Service,
        [Microsoft.Exchange.WebServices.Data.EmailMessage]$Message
    )
    
    try {
        if (-not $Message.ConversationId) {
            Write-Log "Message has no conversation ID, treating as standalone"
            return @($Message)
        }
        
        $conversationId = $Message.ConversationId.UniqueId
        Write-Log "Retrieving conversation messages for: $conversationId"
        
        # Check cache
        if ($global:ConversationCache.ContainsKey($conversationId)) {
            Write-Log "Conversation already processed, using cached data"
            return $global:ConversationCache[$conversationId].Messages
        }
        
        <# Search for all messages in the conversation
        $view = New-Object Microsoft.Exchange.WebServices.Data.ItemView(100)
        $filter = New-Object Microsoft.Exchange.WebServices.Data.SearchFilter+IsEqualTo(
            [Microsoft.Exchange.WebServices.Data.EmailMessageSchema]::ConversationId,
            $Message.ConversationId
        )
        
        $findResults = $Service.FindItems([Microsoft.Exchange.WebServices.Data.WellKnownFolderName]::MsgFolderRoot, $filter, $view)
        
        #>

        # Properties you want on each item
        $ps = New-Object Microsoft.Exchange.WebServices.Data.PropertySet(
            [Microsoft.Exchange.WebServices.Data.BasePropertySet]::IdOnly,
            [Microsoft.Exchange.WebServices.Data.EmailMessageSchema]::Subject,
            [Microsoft.Exchange.WebServices.Data.EmailMessageSchema]::DateTimeReceived
        )
        
        # Sort order (e.g., TreeOrderDescending)
        $sortOrder = [Microsoft.Exchange.WebServices.Data.ConversationSortOrder]::TreeOrderDescending

        <# Folders to ignore (optional)
        $ignoreFolders = New-Object 'System.Collections.Generic.List[Microsoft.Exchange.WebServices.Data.FolderId]'
        $ignoreFolders.Add([Microsoft.Exchange.WebServices.Data.WellKnownFolderName]::DeletedItems)
        $ignoreFolders.Add([Microsoft.Exchange.WebServices.Data.WellKnownFolderName]::Drafts)
        #>

        #retry
        $Attempt = 1
        $conStat = $false
        
        do {
            try {
                # Retrieve conversation items
                $response = $service.GetConversationItems(
                    $conversationId,
                    $ps,
                    $null,          # SyncState (omit or reuse if you cache it)
                    $null,           #$ignoreFolders,
                    $sortOrder
                )
                $conStat = $true
        
            }
            catch {
                write-Log "Message not bound..."   -Level ERROR
                if ($_.ToString() -match 'Unauthorized'){
                    Start-Sleep -Seconds 30
                    $script:exchservice = (New-EWSService2 -Mailbox $MailboxName)[-1]
                }


            }
            $Attempt++
            
        } while ($Attempt -lt 5 -and $conStat -eq $false)
        
        
        #Write-Log "Found conversation messages: $($findResults.Items.count)"
        $messages = @()
        
        #$response | Format-List | Out-Host
        
        foreach ($node in @($response.ConversationNodes)) {
            
            #$node | Format-List | Out-Host
            
            #Write-Log "Parent Index: $($node.ParentConversationIndex)"
            #Write-Log "Node Index:   $($node.ConversationIndex)"

            #$node.Items | Format-List | Out-Host



            foreach ($item in $node.Items) {
                        
                $propertySet = New-Object Microsoft.Exchange.WebServices.Data.PropertySet([Microsoft.Exchange.WebServices.Data.BasePropertySet]::FirstClassProperties)
                $propertySet.RequestedBodyType = [Microsoft.Exchange.WebServices.Data.BodyType]::HTML
                $item.Load($propertySet)
                $messages += $item
                
                
                #$msg = [Microsoft.Exchange.WebServices.Data.EmailMessage]$item
                #Write-Log "  ID:      $($msg.Id.UniqueId)"
                #Write-Log "  Subject: $($msg.Subject)"
                #Write-Log "  Received: $($msg.DateTimeReceived)"
            }
        }
        
        
        <#
        #$messages = @()
        foreach ($item in $findResults.Items) {
            $propertySet = New-Object Microsoft.Exchange.WebServices.Data.PropertySet([Microsoft.Exchange.WebServices.Data.BasePropertySet]::FirstClassProperties)
            $propertySet.RequestedBodyType = [Microsoft.Exchange.WebServices.Data.BodyType]::HTML
            $item.Load($propertySet)
            $messages += $item
        }
        #>
        
        Write-Log "Found $($messages.Count) messages in conversation"
        
        # Cache conversation info
        $global:ConversationCache[$conversationId] = @{
            Messages = $messages
            ProcessedAttachments = @{}
        }
        
        return $messages
    } catch {
        $_ | Out-Host
        Write-Log "Failed to retrieve conversation messages: $_" -Level "ERROR"
        return @($Message)
    }
}

# Create output directory structure
function New-OutputDirectory {
    param(
        [Microsoft.Exchange.WebServices.Data.EmailMessage]$Message,
        [string]$BasePath,
        [string]$Mailbox
    )
    
    try {
        # Create mailbox folder
        $mailboxFolder = Join-Path $BasePath $Mailbox.Replace("@", "_at_")
        
        # Get parent folder path
        $folderPath = "Inbox" # Default
        try {
            if ($Message.ParentFolderId) {
                $folder = [Microsoft.Exchange.WebServices.Data.Folder]::Bind($Message.Service, $Message.ParentFolderId)
                $folderPath = $folder.DisplayName
            }
        } catch {
            Write-Log "Could not retrieve parent folder, using default" -Level "WARN"
        }
        
        $subfolderPath = Join-Path $mailboxFolder $folderPath
        
        # Create message-specific folder
        $dateStr = $Message.DateTimeReceived.ToString("yyyy-MM-dd_HHmmss")
        $recipient = "Unknown"
        if ($Message.ToRecipients.Count -gt 0) {
            $recipient = $Message.ToRecipients[0].Address -replace '[<>:"/\\|?*]', '_'
        }
        
        $messageFolderName = "${dateStr}_${recipient}"
        $messagePath = Join-Path $subfolderPath $messageFolderName
        
        if (-not (Test-Path $messagePath)) {
            if ($dryRun){
                Write-Log "!!!!!!! Just simulation, nothing created actually !!!!!!!" -Level TEST
            } else {
                New-Item -Path $messagePath -ItemType Directory -Force | Out-Null
                Write-Log "Created directory: $messagePath"
            }
        }
        
        return $messagePath
    } catch {
        Write-Log "Failed to create output directory: $_" -Level "ERROR"
        throw
    }
}

