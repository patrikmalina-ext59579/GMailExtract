# Initialize logging
$logPath = Join-Path $ExportBasePath "export_log.txt"
function Write-Log {
    
    param(
    [string]$Message, 
    [Parameter(Mandatory=$false)]
    [ValidateSet("INFO", "WARNING", "ERROR", "DEBUG", "TEST")]
    [string]$Level = "INFO"
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    switch ($level){
        
        "INFO" {Write-Host $logMessage; break}
        "WARNING" {Write-Host $logMessage -ForegroundColor Yellow; break}
        "ERROR" {Write-Host $logMessage -ForegroundColor Red; break}
        "DEBUG" {Write-Host $logMessage -ForegroundColor cyan; break}
        "TEST" {Write-Host $logMessage -ForegroundColor green  ; break}
        default {Write-Host $logMessage -ForegroundColor magenta}
    }
    
    
    
    
    try {
        Add-Content -Path $logPath -Value $logMessage -ErrorAction Stop
    } catch {
        Write-Warning "Failed to write to log: $_"
    }
}

# Load EWS Managed API
function Initialize-EWS {
    try {
        Write-Log "Loading EWS Managed API..."
        
        # Try to load from GAC or common paths
        $ewsDll = "Microsoft.Exchange.WebServices.dll"
        $ewsPaths = @(
            "C:\Program Files\Microsoft\Exchange\Web Services\2.2\$ewsDll",
            "C:\Program Files (x86)\Microsoft\Exchange\Web Services\2.2\$ewsDll",
            "$PSScriptRoot\$ewsDll"
        )
        
        $loaded = $false
        foreach ($path in $ewsPaths) {
            if (Test-Path $path) {
                Import-Module $path -ErrorAction Stop
                $loaded = $true
                Write-Log "EWS API loaded from: $path"
                break
            }
        }
        
        if (-not $loaded) {
            throw "EWS Managed API DLL not found. Please install from: https://www.microsoft.com/en-us/download/details.aspx?id=42951"
        }
        
        return $true
    } catch {
        Write-Log "Failed to load EWS API: $_" -Level "ERROR"
        throw
    }
}

# Create EWS Service connection
function New-EWSService {
    param([string]$Mailbox)
    
    try {
        Write-Log "Creating EWS service connection for: $Mailbox"
        
        $service = New-Object Microsoft.Exchange.WebServices.Data.ExchangeService([Microsoft.Exchange.WebServices.Data.ExchangeVersion]::Exchange2013_SP1)
        $service.Url = New-Object Uri($EwsUrl)
        
        # Use default credentials (Windows authentication)
        $service.UseDefaultCredentials = $true
        
        # Alternatively, use specific credentials:
        # $service.Credentials = New-Object System.Net.NetworkCredential("username", "password", "domain")
        
        # Set impersonation if needed
        $service.ImpersonatedUserId = New-Object Microsoft.Exchange.WebServices.Data.ImpersonatedUserId([Microsoft.Exchange.WebServices.Data.ConnectingIdType]::SmtpAddress, $Mailbox)
        
        Write-Log "EWS service connection established"
        return $service
    } catch {
        Write-Log "Failed to create EWS service: $_" -Level "ERROR"
        throw
    }
}

function Get-CertificateByThumbprint {
    param(
        [string]$Thumbprint
    )

    try {
        Write-Log "Loading certificate from store with thumbprint: $Thumbprint"

        # Search in CurrentUser\My store first
        $cert = Get-ChildItem -Path Cert:\CurrentUser\My | Where-Object { $_.Thumbprint -eq $Thumbprint } | Select-Object -First 1

        if ($cert) {
            Write-Log "Certificate found in CurrentUser\My store"
            return $cert
        }

        # If not found, search in LocalMachine\My store
        $cert = Get-ChildItem -Path Cert:\LocalMachine\My | Where-Object { $_.Thumbprint -eq $Thumbprint } | Select-Object -First 1

        if ($cert) {
            Write-Log "Certificate found in LocalMachine\My store"
            return $cert
        }

        throw "Certificate with thumbprint '$Thumbprint' not found in CurrentUser\My or LocalMachine\My stores"
    }
    catch {
        Write-Log "Error loading certificate: $($_.Exception.Message)" -Level ERROR
        throw
    }
}

