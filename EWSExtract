# Export attachment
function Export-Attachment {
    param(
        [Microsoft.Exchange.WebServices.Data.Attachment]$Attachment,
        [string]$OutputPath,
        [string]$ConversationId
    )
    
    try {
        # Check if attachment already processed in this conversation
        $attachmentKey = "$($Attachment.Name)_$($Attachment.Size)"
        
        if ($global:ConversationCache.ContainsKey($ConversationId) -and 
            $global:ConversationCache[$ConversationId].ProcessedAttachments.ContainsKey($attachmentKey)) {
            Write-Log "Attachment already exported in this conversation: $($Attachment.Name)"
            return $null
        }
        
        #retry
        $Attempt = 1
        $conStat = $false
        
        do {
            try {
                # Retrieve conversation items
                # Load attachment content
                $Attachment.Load()
        
                $conStat = $true
        
            }
            catch {
                write-Log "Message not bound..."   -Level ERROR
                if ($_.ToString() -match 'Unauthorized'){
                    Start-Sleep -Seconds 30
                    $script:exchservice = (New-EWSService2 -Mailbox $MailboxName)[-1]
                }


            }
            $Attempt++
            
        } while ($Attempt -lt 5 -and $conStat -eq $false)
        
        
        
        # Handle file attachments
        if ($Attachment -is [Microsoft.Exchange.WebServices.Data.FileAttachment]) {
            $fileName = $Attachment.Name -replace '[<>:"/\\|?*]', '_'
            $filePath = Join-Path $OutputPath $fileName
            
            # Ensure unique filename
            $counter = 1
            while (Test-Path $filePath) {
                $baseName = [System.IO.Path]::GetFileNameWithoutExtension($fileName)
                $extension = [System.IO.Path]::GetExtension($fileName)
                $filePath = Join-Path $OutputPath "${baseName}_${counter}${extension}"
                $counter++
            }
            
            if ($dryRun){
                Write-Log "!!!!!!! Just simulation, nothing created actually !!!!!!!" -Level TEST
            } else {
                [System.IO.File]::WriteAllBytes($filePath, $Attachment.Content)
                Write-Log "Exported attachment: $filePath"
            }
            
            # Mark as processed
            if ($global:ConversationCache.ContainsKey($ConversationId)) {
                $global:ConversationCache[$ConversationId].ProcessedAttachments[$attachmentKey] = $filePath
            }
            
            return $filePath
        }
        
        return $null
    } catch {
        Write-Log "Failed to export attachment $($Attachment.Name): $_" -Level "ERROR"
        return $null
    }
}

