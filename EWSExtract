        }
                
        $lineCounter++
    }
    
} catch {
    Write-Log "Script execution failed: $_" -Level "ERROR"
    Write-Host "`nScript execution failed: $_" -ForegroundColor Red
    exit 1
}

$results | Export-Csv "$ExportBasePath/results.csv" -NoTypeInformation  -Encoding Unicode
$actionStatuses | ConvertTo-Json -Depth 3 | Set-Content "$ExportBasePath\actionStatuses.json"  -Encoding Unicode
$actionStatuses | Export-Clixml "$ExportBasePath\actionStatuses.xml" -Depth 3  -Encoding Unicode
$actionStatuses | Export-Csv "$ExportBasePath\actionStatuses.csv" -NoTypeInformation  -Encoding Unicode

